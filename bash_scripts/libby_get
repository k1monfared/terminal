#!/usr/bin/env bash
# libby_get - file Libby downloads from ~/Downloads into "$audiobooks_folder/Author - Title/".
# Each book downloads with a "<title-slug>__" filename prefix so multiple books in
# ~/Downloads do not collide. Every pending manifest is processed, stripping the prefix
# as files are moved. Needs only bash 3.2+ (so it runs on stock macOS too).
. "$(cd "$(dirname "$0")" && pwd)/lib/platform.sh"

shopt -s nullglob
manifests=("$HOME/Downloads/"*"__libby_manifest.sh")
# legacy unprefixed manifest from older script versions
[[ -f "$HOME/Downloads/libby_manifest.sh" ]] && manifests+=("$HOME/Downloads/libby_manifest.sh")
if (( ${#manifests[@]} == 0 )); then
    echo "No manifest found. Open a book in the Libby web player and click Download."
    exit 1
fi

# Split audiobooks from supplementary content (kind="supplement"). Audiobooks
# are processed first so supplements can be filed into the same folder.
audio=() supp=()
for m in "${manifests[@]}"; do
    if grep -q '^kind="supplement"' "$m"; then supp+=("$m"); else audio+=("$m"); fi
done

# title -> destination folder, for supplements to join (parallel arrays: no bash 4 needed)
audio_titles=() audio_dirs=()

move_files() {   # move_files DIR  (uses $files from the sourced manifest)
    local f src clean
    for f in "${files[@]}"; do
        src="$HOME/Downloads/$f"; clean="${f##*__}"   # strip "<slug>__" prefix (no-op for legacy names)
        if [[ -f "$src" ]]; then mv "$src" "$1/$clean"; echo "Moved: $clean"
        else echo "Missing: $f (skipped)"; fi
    done
}

# Pass 1: audiobooks
for manifest in "${audio[@]}"; do
    title=""; author=""; metadata=""; kind=""; files=()
    source "$manifest"
    # Prefill the captured author as an editable line (readline, bash 4+): edit in place or
    # press Enter to keep; clear it to file the book with no "Author - " prefix.
    if (( BASH_VERSINFO[0] >= 4 )); then
        read -rep "Author for \"$title\": " -i "$author" author
    else
        read -rp "Author for \"$title\" [$author] (Enter keeps, '-' clears): " reply
        case "$reply" in "") ;; "-") author="" ;; *) author="$reply" ;; esac
    fi
    dir="$audiobooks_folder${author:+$author - }$title"
    audio_titles+=("$title"); audio_dirs+=("$dir")
    mkdir -p "$dir"
    move_files "$dir"
    if [[ -n "$metadata" && -f "$HOME/Downloads/$metadata" ]]; then
        mv "$HOME/Downloads/$metadata" "$dir/${metadata##*__}"; echo "Moved: ${metadata##*__}"
    fi
    mv "$manifest" "$dir/libby_manifest.sh"
    echo "Done: $dir"
done

# Pass 2: supplements -- always go into the audiobook's folder. Match by title to a folder
# created this run, or already on disk ("<author> - <title>" / "<title>"); only fall back
# to the supplement's own metadata if no audiobook folder exists.
for manifest in "${supp[@]}"; do
    title=""; author=""; metadata=""; kind=""; files=()
    source "$manifest"
    dir=""
    for i in "${!audio_titles[@]}"; do
        [[ "${audio_titles[$i]}" == "$title" ]] && { dir="${audio_dirs[$i]}"; break; }
    done
    if [[ -z "$dir" ]]; then
        for d in "$audiobooks_folder"*" - $title" "$audiobooks_folder$title"; do
            [[ -d "$d" ]] && { dir="$d"; break; }
        done
    fi
    [[ -z "$dir" ]] && dir="$audiobooks_folder${author:+$author - }$title"
    mkdir -p "$dir"
    move_files "$dir"
    # keep the audiobook's libby_manifest.sh; park the supplement's under its own name
    if [[ -e "$dir/libby_manifest.sh" ]]; then base="${manifest##*/}"; mv "$manifest" "$dir/$base"
    else mv "$manifest" "$dir/libby_manifest.sh"; fi
    echo "Done (supplement): $dir"
done

mkdir -p "$public_notes_folder"
ls "$audiobooks_folder" > "$public_notes_folder/audiobooks"
