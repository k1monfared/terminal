#!/bin/bash
# public IPv4/IPv6 and rough location (curl only: wget is not on a stock Mac)

PUBLIC_IPv4=$(curl -s -4 ifconfig.co)
PUBLIC_IPv6=$(curl -s -6 ifconfig.co)
INFO=$(curl -s "ipinfo.io/$PUBLIC_IPv4")
field() { echo "$INFO" | grep "\"$1\"" | awk -F: '{print $2}' | tr -d ' ",\n'; }
echo "IPv4: $PUBLIC_IPv4"
echo "IPv6: $PUBLIC_IPv6"
echo "Location: $(field city), $(field region), $(field country)"
