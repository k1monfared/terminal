#!/bin/bash

## This script downloads a youtube video given its ID (if it is not already in ~/Videos) and plays it once.
## For example, the id for https://www.youtube.com/watch?v=2QTf8Yjn7Hk is the part after "v=", i.e. "2QTf8Yjn7Hk"
## The usage is: ytp VIDEO_ID, for example: ytp 2QTf8Yjn7Hk
## Needs yt-dlp plus a player (mpv, mplayer or vlc). Works on Linux and macOS.

. "$(cd "$(dirname "$0")/.." && pwd)/lib/platform.sh"

if [[ $(echo $*) ]]; then
    searchterm="$*"
else
    read -p "Enter video ID: " searchterm
fi

searchterm=$(echo $searchterm | sed -e 's/ /+/g')

mkdir -p ~/Videos
[[ -f ~/Videos/$searchterm.mp4 ]] || yt-dlp -f 'mp4/best' -o ~/Videos/$searchterm.mp4 "https://www.youtube.com/watch?v=$searchterm" || exit 1

play_media ~/Videos/$searchterm.mp4
