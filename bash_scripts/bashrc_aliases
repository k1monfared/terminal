# opencode wrappers
#   chat                                  REPL (opencode TUI, pick or continue a session)
#   chat "question"                       one-shot (opencode run)
#   chat -s SESSION                       REPL in session SESSION (or opencode session id)
#   chat -m PROVIDER/MODEL "..."          one-shot on a specific model
#   chat -m PROVIDER:MODEL "..."          aichat-style colon also works, converted to /
#   chats                                 view invocation history (timestamp, model, session)
chat() {
    if [[ "$1" == "help" || "$1" == "-h" || "$1" == "--help" ]]; then
        cat <<'EOF'
chat cheatsheet

USAGE
  chat                              REPL (opencode TUI, pick or continue a session)
  chat "question"                   one-shot, no session (opencode run)
  chat -s SESSION "question"        one-shot in session SESSION
  chat -s SESSION                   REPL in session SESSION
  chat -m PROVIDER/MODEL "..."      one-shot on a specific model
  chat -m PROVIDER:MODEL "..."      aichat-style colon is converted to a slash
  chat -m MODEL -s SESSION "..."    both pinned
  chat help                         this cheatsheet
  chats                             view invocation history (less +G on the log)

REPL  (inside the opencode TUI)
  /new                              start a new session
  /continue                         continue the last session
  /sessions                         switch or resume a session
  /models                           switch model
  /help                             full opencode help

PROVIDERS  (use as PROVIDER/MODEL with -m)
  opencode    OpenCode Zen (opencode/deepseek-v4-flash-free is the default)
  gemini      Google AI Studio
  github      GitHub Models
  openrouter  OpenRouter
  ...         anything `opencode models` lists

LISTS
  opencode models                   all available models
  opencode session list             saved sessions

FILES
  ~/.config/opencode/opencode.json  model + provider config
  ~/.config/opencode/invocations.log  what `chat` logs (timestamp, model, session)
EOF
        return 0
    fi

    local args=("$@")
    local msgs=() extra=() model="" session="" m i
    for (( i=0; i<${#args[@]}; i++ )); do
        case "${args[$i]}" in
            -m|--model)
                m="${args[$((i+1))]:-}"
                model="${m//:/\/}"
                [[ -n "$model" ]] && extra+=(--model "$model")
                i=$((i+1))
                ;;
            -s|--session)
                session="${args[$((i+1))]:-}"
                [[ -n "$session" ]] && extra+=(--session "$session")
                i=$((i+1))
                ;;
            -*) extra+=("${args[$i]}") ;;
            *)  msgs+=("${args[$i]}") ;;
        esac
    done

    mkdir -p "$HOME/.config/opencode"
    printf '%s\tmodel=%s\tsession=%s\targs=%s\n' \
        "$(date -Iseconds)" "${model:-(config default)}" "${session:-(ephemeral)}" "${args[*]}" \
        >> "$HOME/.config/opencode/invocations.log"

    if (( ${#msgs[@]} == 0 )); then
        opencode "${extra[@]}"
    else
        opencode run "${extra[@]}" "${msgs[@]}"
    fi
}
alias chats='less +G ~/.config/opencode/invocations.log'

