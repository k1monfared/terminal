## project creation
new_project() {
    # Ask for project name
    echo -n "Enter project name: "
    read -r project_name

    # Replace spaces with underscores and keep only alphanumeric characters and underscores
    clean_name=$(printf '%s' "$project_name" | sed 's/ /_/g' | sed 's/[^a-zA-Z0-9_]//g')
    if [[ -z "$clean_name" ]]; then
        echo "Invalid project name."
        return 1
    fi

    # Check if directory already exists
    project_path="$HOME/public/$clean_name"
    while [[ -d "$project_path" ]]; do
        echo "Directory already exists: $project_path"
        echo "Contents:"
        ls -la "$project_path"
        echo
        echo -n "Enter a new project name [$clean_name]: "
        read -r new_name
        if [[ -n "$new_name" ]]; then
            clean_name=$(printf '%s' "$new_name" | sed 's/ /_/g' | sed 's/[^a-zA-Z0-9_]//g')
        fi
        project_path="$HOME/public/$clean_name"
    done

    # Create project directory
    mkdir -p "$project_path" || return 1

    # Claude Code template no longer offered (claude usage commented out)
    # echo -n "Use Claude Code template? (y/n): "
    # read use_claude

    # if [[ "$use_claude" == "y" || "$use_claude" == "Y" ]]; then
    #     template_path="$HOME/public/claude_code_project_template"
    #     if [[ -d "$template_path" ]]; then
    #         cp -r "$template_path"/. "$project_path/"
    #         echo "Claude Code template copied to $project_path"
    #     else
    #         echo "Warning: Claude Code template not found at $template_path"
    #     fi
    # fi

    # Change to project directory and initialize git
    cd "$project_path" || return 1
    git init || return 1

    # Make sure there is something to commit (a fresh dir has nothing but .git)
    if ! compgen -G '*' > /dev/null; then
        printf '# %s\n' "$clean_name" > readme.md
    fi

    # Ask if repository should be public
    echo -n "Make repository public? (y/n, default is private): "
    read -r make_public

    # Add all files and make initial commit
    git add --all
    if ! git commit -m "Initial commit"; then
        echo "Initial commit failed."
        return 1
    fi

    # Create GitHub repository (no --push yet: force the remote to SSH first so
    # pushes use the SSH key, not gh's https credential helper). See git_protocol note.
    if [[ "$make_public" == "y" || "$make_public" == "Y" ]]; then
        visibility=public
    else
        visibility=private
    fi
    if ! gh repo create "$clean_name" --$visibility --source . --remote origin; then
        echo "Failed to create GitHub repository. Is gh authenticated and the repo not already taken?"
        return 1
    fi

    # Rewrite origin from https://github.com/OWNER/REPO(.git) to git@github.com:OWNER/REPO.git
    if ! ssh_url=$(_force_ssh_remote); then
        return 1
    fi

    if ! git push --set-upstream origin HEAD; then
        echo "Push failed. Check SSH auth to GitHub (ssh -T git@github.com)."
        return 1
    fi

    echo "GitHub repository created and connected (origin: $ssh_url)"

    # Open readme.log in vscode
    readme_file="$project_path/readme.log"
    if [[ ! -f "$readme_file" ]]; then
        touch "$readme_file"
    fi
    $EDITOR "$readme_file"

    echo "Project '$clean_name' created at $project_path"
}

# library
libby_get ()
{
    # Each book downloads with a "<title-slug>__" filename prefix so multiple books
    # in ~/Downloads do not collide. Process every pending manifest, stripping the
    # prefix as files are moved into "$audiobooks_folder/Author - Title/".
    shopt -s nullglob
    local manifests=("$HOME/Downloads/"*"__libby_manifest.sh")
    # legacy unprefixed manifest from older script versions
    [[ -f "$HOME/Downloads/libby_manifest.sh" ]] && manifests+=("$HOME/Downloads/libby_manifest.sh")
    if (( ${#manifests[@]} == 0 )); then
        echo "No manifest found. Open a book in the Libby web player and click Download."
        return 1
    fi

    # Split audiobooks from supplementary content (kind="supplement"). Audiobooks
    # are processed first so supplements can be filed into the same folder.
    local m audio=() supp=()
    for m in "${manifests[@]}"; do
        if grep -q '^kind="supplement"' "$m"; then supp+=("$m"); else audio+=("$m"); fi
    done

    local manifest title author metadata kind dir d f src clean base
    local -a files
    local -A audio_dir          # title -> destination folder, for supplements to join

    # Pass 1: audiobooks
    for manifest in "${audio[@]}"; do
        title=""; author=""; metadata=""; kind=""; files=()
        source "$manifest"
        # Prefill the captured author as an editable line (readline): edit in place or
        # press Enter to keep; clear it to file the book with no "Author - " prefix.
        read -rep "Author for \"$title\": " -i "$author" author
        dir="$audiobooks_folder${author:+$author - }$title"
        audio_dir["$title"]="$dir"
        mkdir -p "$dir"
        for f in "${files[@]}"; do
            src="$HOME/Downloads/$f"; clean="${f##*__}"   # strip "<slug>__" prefix (no-op for legacy names)
            if [[ -f "$src" ]]; then mv "$src" "$dir/$clean"; echo "Moved: $clean"
            else echo "Missing: $f (skipped)"; fi
        done
        if [[ -n "$metadata" && -f "$HOME/Downloads/$metadata" ]]; then
            mv "$HOME/Downloads/$metadata" "$dir/${metadata##*__}"; echo "Moved: ${metadata##*__}"
        fi
        mv "$manifest" "$dir/libby_manifest.sh"
        echo "Done: $dir"
    done

    # Pass 2: supplements — always go into the audiobook's folder. Match by title
    # to a folder created this run, or already on disk ("<author> - <title>" / "<title>");
    # only fall back to the supplement's own metadata if no audiobook folder exists.
    for manifest in "${supp[@]}"; do
        title=""; author=""; metadata=""; kind=""; files=()
        source "$manifest"
        dir=""
        if [[ -n "${audio_dir["$title"]+x}" ]]; then
            dir="${audio_dir["$title"]}"
        else
            for d in "$audiobooks_folder"*" - $title" "$audiobooks_folder$title"; do
                [[ -d "$d" ]] && { dir="$d"; break; }
            done
        fi
        [[ -z "$dir" ]] && dir="$audiobooks_folder${author:+$author - }$title"
        mkdir -p "$dir"
        for f in "${files[@]}"; do
            src="$HOME/Downloads/$f"; clean="${f##*__}"
            if [[ -f "$src" ]]; then mv "$src" "$dir/$clean"; echo "Moved: $clean"
            else echo "Missing: $f (skipped)"; fi
        done
        # keep the audiobook's libby_manifest.sh; park the supplement's under its own name
        if [[ -e "$dir/libby_manifest.sh" ]]; then base="${manifest##*/}"; mv "$manifest" "$dir/$base"
        else mv "$manifest" "$dir/libby_manifest.sh"; fi
        echo "Done (supplement): $dir"
    done

    ls "$audiobooks_folder" > "$public_notes_folder/audiobooks"
}

