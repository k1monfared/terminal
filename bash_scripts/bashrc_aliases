# Force origin to the SSH URL so pushes use the SSH key, not gh's https
# credential helper. Returns the SSH URL on success, non-zero if the URL is
# unexpected. Safe to call when origin is already SSH.
_force_ssh_remote() {
    local url ssh_url
    url=$(git remote get-url origin 2>/dev/null)
    case "$url" in
        https://github.com/*)
            ssh_url="git@github.com:${url#https://github.com/}"
            ssh_url="${ssh_url%.git}.git"
            ;;
        git@*)
            ssh_url="$url"
            ;;
        *)
            echo "Unexpected origin URL: $url" >&2
            return 1
            ;;
    esac
    git remote set-url origin "$ssh_url"
    printf '%s' "$ssh_url"
}
git_init ()
{
    cwd=$(basename "$(pwd)")
    git init &&
    git add --all &&
    git commit -m "Initial commit" &&
    gh repo create "$cwd" --private --source . --remote origin &&
    ssh_url=$(_force_ssh_remote) &&
    git push --set-upstream origin HEAD
}
git_push_all ()
{
    message=$*
    if [[ $(echo $message) ]]; then
        message=$message
    else
        message="quick commit"
    fi
    git status && git add --all && git commit -m "$message" && git push
    remote_url=$(git config --get remote.origin.url)
    echo "Repository link: https://$(echo $remote_url | sed 's/.*@//;s/:/\//;s/.git$//')"
}
git_activate ()
{
    mkdir -p "$HOME/opt/git_config" && echo $1 > "$HOME/opt/git_config/active_git_account"
}
git_clone ()
{
    # get the active git account name
    #account=$(<"$HOME/opt/git_config/active_git_account")
    account=$1
    git_link=$2
    # get everything from the first colon
    sublink=$(echo $git_link |
        sed 's/^[^:]*[:]//')
    # get repo name
    repo=$(echo $sublink |
        sed 's/.*\///')
    repo=${repo%.*}
    git clone git@${account}:$sublink &&
    cd $repo &&
    git_switch $account
}

