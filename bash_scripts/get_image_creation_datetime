#!/bin/bash
# needs exiftool (apt install libimage-exiftool-perl / brew install exiftool)
command -v exiftool >/dev/null || { echo "exiftool not installed" >&2; exit 1; }

DATE=$(exiftool "$1" | grep 'Create Date' | awk '{print $4}')
TIME=$(exiftool "$1" | grep 'Create Date' | awk '{print $5}')

#if [ ${#DATE} -eq 0 ]
#then
#    DATE=$(exiftool "$1" | grep 'File Modification Date/Time' | awk '{print $5}')
#fi

echo "${DATE:0:4}-${DATE:5:2}-${DATE:8:2} ${TIME:0:8}"
